<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bl_qz_tray_engine.BlQzDevicePanel">
        <div class="o_bl_qz_device_panel">
            <div class="p-0">
                <t t-if="state.loading">
                    <div class="text-muted">Cargando configuracion del equipo...</div>
                </t>

                <t t-elif="state.error">
                    <div class="alert alert-danger mb-0" role="alert">
                        <t t-esc="state.error"/>
                    </div>
                </t>

                <t t-else="">
                    <t t-if="!props.basic">
                    <div class="bl-opt">
                        <span class="bl-num bl-num-sm"><t t-esc="nums.enabled"/></span>
                        <div class="bl-opt-body">
                            <p class="bl-opt-label">Usar impresion por QZ Tray en este equipo<span class="bl-review-tag">pasa al primer lugar</span></p>
                            <p class="bl-opt-help">Si lo apagas, esta computadora imprime con el navegador y no se muestran las demas opciones.</p>
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    t-att-id="'bl_qz_enabled_' + (state.device and state.device.id or 0)"
                                    t-att-checked="state.qz_enabled"
                                    t-on-change="onEnabledChange"
                                    t-att-disabled="readonly or state.saving"
                                />
                                <label class="form-check-label" t-att-for="'bl_qz_enabled_' + (state.device and state.device.id or 0)">
                                    Activado en este equipo
                                </label>
                            </div>
                        </div>
                    </div>
                    </t>
                    <div t-if="props.basic and !state.qz_enabled" class="alert alert-warning">QZ Tray esta apagado en este equipo y no imprime por QZ. Se vuelve a encender en Configuracion y ajustes, en Modulos BlackLabs.</div>

                    <t t-if="props.basic or state.qz_enabled">
                    <div class="bl-opt">
                        <span class="bl-num bl-num-sm"><t t-esc="nums.name"/></span>
                        <div class="bl-opt-body">
                            <p class="bl-opt-label">Nombre de este equipo<span class="bl-review-tag">queda igual</span></p>
                            <p class="bl-opt-help">Es el nombre con el que aparece esta computadora en la lista de equipos.</p>
                            <input
                                type="text"
                                class="form-control"
                                t-att-value="state.device_name"
                                t-on-change="onDeviceNameChange"
                                t-att-readonly="readonly or state.saving"
                            />
                        </div>
                    </div>

                    <div class="bl-opt">
                        <span class="bl-num bl-num-sm"><t t-esc="nums.mode"/></span>
                        <div class="bl-opt-body">
                            <p class="bl-opt-label">Modo de impresora<span class="bl-review-tag">queda igual</span></p>
                            <p class="bl-opt-help">Una impresora para todos los comprobantes, o una distinta para cada uno.</p>
                            <div class="d-flex gap-4 flex-wrap">
                                <div class="form-check">
                                    <input
                                        class="form-check-input"
                                        type="radio"
                                        t-att-id="'bl_qz_mode_global_' + (state.device and state.device.id or 0)"
                                        name="bl_qz_mode"
                                        value="global"
                                        t-att-checked="state.printer_mode === 'global'"
                                        t-on-change="onModeGlobalChange"
                                        t-att-disabled="readonly or state.saving"
                                    />
                                    <label class="form-check-label" t-att-for="'bl_qz_mode_global_' + (state.device and state.device.id or 0)">
                                        Una impresora para todos los modulos
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input
                                        class="form-check-input"
                                        type="radio"
                                        t-att-id="'bl_qz_mode_module_' + (state.device and state.device.id or 0)"
                                        name="bl_qz_mode"
                                        value="per_module"
                                        t-att-checked="state.printer_mode === 'per_module'"
                                        t-on-change="onModePerModuleChange"
                                        t-att-disabled="readonly or state.saving"
                                    />
                                    <label class="form-check-label" t-att-for="'bl_qz_mode_module_' + (state.device and state.device.id or 0)">
                                        Impresora propia por modulo
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-if="!isPerModule">
                        <div class="bl-opt">
                            <span class="bl-num bl-num-sm"><t t-esc="nums.printer"/></span>
                            <div class="bl-opt-body">
                                <p class="bl-opt-label">Impresora del equipo<span class="bl-review-tag">queda igual</span></p>
                                <p class="bl-opt-help">La impresora que usa esta computadora para todos los comprobantes.</p>
                                <div class="d-flex gap-2 flex-wrap">
                                    <input
                                        type="text"
                                        class="form-control"
                                        t-att-value="state.printer_name"
                                        t-on-change="onGlobalPrinterChange"
                                        t-att-readonly="readonly or state.saving"
                                    />
                                    <button
                                        type="button"
                                        class="btn bl_qz_detect_btn"
                                        t-on-click="onDetectPrinters"
                                        t-att-disabled="readonly or state.saving or state.detecting"
                                    >
                                        <t t-if="state.detecting">
                                            <i class="fa fa-spinner fa-spin me-1"/>
                                            Buscando...
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-magic me-1"/>
                                            Detectar impresoras
                                        </t>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="bl-opt">
                            <span class="bl-num bl-num-sm"><t t-esc="nums.copies"/></span>
                            <div class="bl-opt-body">
                                <p class="bl-opt-label">Cantidad de copias<span class="bl-review-tag">vuelve, ahora con interruptor</span></p>
                                <p class="bl-opt-help">Encendido: todos los comprobantes de esta computadora imprimen la misma cantidad. Apagado: cada modulo usa su propia cantidad.</p>
                                <div class="form-check form-switch bl-switch">
                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        role="switch"
                                        t-att-id="'bl_qz_copies_all_' + (state.device and state.device.id or 0)"
                                        t-att-checked="state.copies_all"
                                        t-on-change="onCopiesAllChange"
                                        t-att-disabled="readonly or state.saving"
                                    />
                                    <label class="form-check-label" t-att-for="'bl_qz_copies_all_' + (state.device and state.device.id or 0)">
                                        Misma cantidad de copias para todos los comprobantes
                                    </label>
                                </div>
                                <div class="d-flex align-items-center gap-3 mt-2">
                                    <input
                                        type="number"
                                        min="1"
                                        max="10"
                                        class="form-control"
                                        style="max-width: 110px;"
                                        t-att-value="state.copies"
                                        t-on-change="onGlobalCopiesChange"
                                        t-att-disabled="readonly or state.saving or !state.copies_all"
                                    />
                                    <span t-if="state.copies_all" class="bl-opt-help m-0">Todos los comprobantes de esta computadora imprimen esta cantidad.</span>
                                    <span t-else="" class="bl-opt-help m-0">Apagado: cada comprobante usa las copias de su modulo (por ejemplo, "Copias del comprobante" en el ticket de venta).</span>
                                </div>
                                <p class="bl-opt-help mt-2">
                                    <span class="bl-review-tag">por ahora lo respetan el ticket de venta y el pago a proveedor; el resto de los modulos se suma uno por uno</span>
                                </p>
                            </div>
                        </div>

                        <div class="bl-opt">
                            <span class="bl-num bl-num-sm"><t t-esc="nums.force"/></span>
                            <div class="bl-opt-body">
                                <p class="bl-opt-label">Force RAW<span class="bl-review-tag">queda igual</span></p>
                                <p class="bl-opt-help">Enviar el ticket en crudo. Usalo solo si el ticket sale con simbolos raros.</p>
                                <div class="form-check">
                                    <input
                                        type="checkbox"
                                        class="form-check-input"
                                        t-att-checked="state.force_raw"
                                        t-on-change="onGlobalForceRawChange"
                                        t-att-disabled="readonly or state.saving"
                                    />
                                    <label class="form-check-label">Activado</label>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="isPerModule">
                        <div class="bl-opt">
                            <span class="bl-num bl-num-sm"><t t-esc="nums.printer"/></span>
                            <div class="bl-opt-body">
                                <p class="bl-opt-label">Impresora para cada comprobante<span class="bl-review-tag">queda igual</span></p>
                                <p class="bl-opt-help">Elegi la impresora de cada comprobante y, si hace falta, activa Force RAW.</p>
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Modulo</th>
                                                <th>Impresora + Detectar</th>
                                                <th class="text-center">Copias</th>
                                                <th class="text-center">Force RAW</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.module_rows" t-as="row" t-key="row.module_key">
                                                <td class="fw-semibold text-capitalize"><t t-esc="row.label"/></td>
                                                <td>
                                                    <div class="d-flex gap-2 flex-wrap">
                                                        <input
                                                            type="text"
                                                            class="form-control"
                                                            t-att-data-module-key="row.module_key"
                                                            t-att-value="row.printer_name"
                                                            t-on-change="onModulePrinterChange"
                                                            t-att-readonly="readonly or state.saving"
                                                        />
                                                        <button
                                                            type="button"
                                                            class="btn bl_qz_detect_btn bl_qz_detect_btn_row"
                                                            t-att-data-module-key="row.module_key"
                                                            t-on-click="onDetectModulePrinter"
                                                            t-att-disabled="readonly or state.saving or state.detecting"
                                                        >
                                                            <i class="fa fa-magic me-1"/>
                                                            Detectar
                                                        </button>
                                                    </div>
                                                </td>
                                                <td style="max-width: 120px;" class="text-center">
                                                    <input
                                                        t-if="row.module_key === 'pago_proveedor'"
                                                        type="number"
                                                        min="1"
                                                        max="10"
                                                        class="form-control text-center"
                                                        t-att-data-module-key="row.module_key"
                                                        t-att-value="row.copies"
                                                        t-on-change="onModuleCopiesChange"
                                                        t-att-readonly="readonly or state.saving"
                                                    />
                                                    <span t-else="" class="text-muted">&#8212;</span>
                                                </td>
                                                <td class="text-center">
                                                    <input
                                                        type="checkbox"
                                                        class="form-check-input"
                                                        t-att-data-module-key="row.module_key"
                                                        t-att-checked="row.force_raw"
                                                        t-on-change="onModuleForceRawChange"
                                                        t-att-disabled="readonly or state.saving"
                                                    />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <p class="bl-opt-help mt-2">
                                    Con una impresora por modulo, cada comprobante usa las copias de su modulo (por ejemplo, "Copias del comprobante" en el ticket de venta). Solo el recibo de pago a proveedor toma su cantidad de esta tabla.
                                    <span class="bl-review-tag">se quito: "Copias" de los demas comprobantes (valian 1)</span>
                                </p>
                            </div>
                        </div>
                    </t>

                    <div class="bl-opt">
                        <span class="bl-num bl-num-sm"><t t-esc="nums.tests"/></span>
                        <div class="bl-opt-body">
                            <p class="bl-opt-label">Pruebas y firma de QZ Tray<span class="bl-review-tag">queda igual</span></p>
                            <p class="bl-opt-help">Imprimí una cabecera de prueba y administrá el certificado de firma.</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <button
                                    type="button"
                                    class="btn btn-secondary"
                                    t-on-click="onPrintHeaderTest"
                                >
                                    Imprimir cabecera de prueba
                                </button>
                                <button
                                    t-if="state.canDownload"
                                    type="button"
                                    class="btn btn-secondary"
                                    t-on-click="onDownloadCertificate"
                                >
                                    Descargar certificado (.pem)
                                </button>
                                <button
                                    t-if="state.canGenerate"
                                    type="button"
                                    class="btn btn-secondary"
                                    t-on-click="onGenerateCertificate"
                                >
                                    Generar / Renovar certificado
                                </button>
                            </div>
                        </div>
                    </div>
                    </t>
                </t>
            </div>
        </div>
    </t>

    <t t-name="bl_qz_tray_engine.BlQzDevicePrinterDialog">
        <Dialog size="'md'" title="props.title || 'Seleccionar impresora QZ'" contentClass="'bl-dialog'">
            <div class="list-group">
                <t t-foreach="props.printers" t-as="printer" t-key="printer.name">
                    <button
                        type="button"
                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                        t-att-data-printer-name="printer.name"
                        t-on-click="onSelectPrinter"
                    >
                        <span t-esc="printer.name"/>
                        <span>
                            <span
                                t-if="printer.isCurrent"
                                class="bl-badge me-1"
                            >
                                Actual
                            </span>
                            <span
                                t-if="printer.isDefault"
                                class="bl-badge"
                            >
                                Predeterminada
                            </span>
                        </span>
                    </button>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="onCancelDialog">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>
</templates>
