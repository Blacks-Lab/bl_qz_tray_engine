<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bl_qz_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bl_qz_tray_engine</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <block id="bl_qz_engine_section" title="Impresora ESC/POS QZ Tray">
                    <setting id="bl_qz_device_panel_settings">
                        <widget name="bl_qz_device_panel"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
