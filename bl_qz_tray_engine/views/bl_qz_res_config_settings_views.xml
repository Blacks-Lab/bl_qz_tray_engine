<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bl_qz_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bl_qz_tray_engine</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Seccion "Modulos BlackLabs": va al final de los ajustes del Punto de Venta.
                 Cada modulo BlackLabs agrega su tarjeta como un <setting> dentro de este bloque. -->
            <xpath expr="//block[@id='pos_inventory_section']" position="after">
                <block id="bl_modules_section" title="Módulos BlackLabs">
                    <setting id="bl_qz_device_panel_settings">
                        <div class="bl-card bl-card-module" id="bl_qz_engine_card">
                            <div class="bl-card-head">
                                <span class="bl-num">1</span>
                                <div>
                                    <p class="bl-card-title">QZ Tray Engine</p>
                                    <p class="bl-card-sub">Impresión de tickets por QZ Tray en cada computadora.
                                    </p>
                                </div>
                            </div>
                            <widget name="bl_qz_device_panel"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
