<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bl_qz_device_form" model="ir.ui.view">
        <field name="name">bl.qz.device.form</field>
        <field name="model">bl.qz.device</field>
        <field name="arch" type="xml">
            <form string="Equipo QZ">
                <sheet>
                    <group>
                        <group string="Equipo">
                            <field name="name"/>
                            <field name="device_uuid" readonly="1"/>
                            <field name="company_id"/>
                            <field name="qz_enabled"/>
                        </group>
                        <group string="Impresoras">
                            <field name="printer_mode"/>
                            <field name="printer_name" widget="bl_qz_printer" readonly="printer_mode != 'global'"/>
                            <field name="printer_ids" readonly="printer_mode != 'per_module'">
                                <list editable="bottom">
                                    <field name="module_key"/>
                                    <field name="printer_name" widget="bl_qz_printer"/>
                                    <field name="copies"/>
                                    <field name="force_raw"/>
                                    <field name="sequence"/>
                                </list>
                            </field>
                        </group>
                    </group>

                    <group string="Firma digital QZ">
                        <button
                            name="action_print_qz_logo_header_test"
                            type="object"
                            string="Imprimir cabecera de prueba"
                            class="btn btn-secondary"
                            groups="point_of_sale.group_pos_user"
                        />
                        <button
                            name="action_download_qz_signing_certificate"
                            type="object"
                            string="Descargar certificado (.pem)"
                            class="btn btn-secondary"
                            groups="point_of_sale.group_pos_manager"
                        />
                        <button
                            name="action_generate_qz_signing_material"
                            type="object"
                            string="Generar / Renovar certificado"
                            class="btn btn-secondary"
                            groups="base.group_system"
                        />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_bl_qz_device_list" model="ir.ui.view">
        <field name="name">bl.qz.device.list</field>
        <field name="model">bl.qz.device</field>
        <field name="arch" type="xml">
            <list string="Impresora ESC/POS QZ Tray">
                <field name="name"/>
                <field name="company_id"/>
                <field name="printer_mode"/>
                <field name="printer_name"/>
                <field name="qz_enabled"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <record id="action_bl_qz_device" model="ir.actions.act_window">
        <field name="name">Impresora ESC/POS QZ Tray</field>
        <field name="res_model">bl.qz.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_bl_qz_device"
        name="Impresora ESC/POS QZ Tray"
        parent="point_of_sale.menu_point_config_product"
        action="action_bl_qz_device"
        sequence="95"
        groups="point_of_sale.group_pos_manager"
    />

    <record id="menu_bl_qz_device" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('point_of_sale.group_pos_manager')])]"/>
    </record>
</odoo>
