<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bl_qz_pos_config_view_form_inherit" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.bl_qz_tray_engine</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <h2>Impresora ESC/POS QZ Tray</h2>
                <div id="bl_qz_pos_config_section" class="row mt16 o_settings_container" invisible="context.get('pos_config_create_mode', False)">
                    <setting id="bl_qz_device_panel_pos_config">
                        <div class="content-group mt16">
                            <widget name="bl_qz_device_panel"/>
                        </div>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
