<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bl_qz_pos_config_view_form_inherit" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.bl_qz_tray_engine</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Seccion "Modulos BlackLabs" del formulario del Punto de Venta (configuracion base,
                 la que usa el cajero para cambiar de impresora, probar la cabecera y bajar el certificado).
                 Cada modulo BlackLabs agrega su tarjeta como un <div class="bl-card"> dentro de bl_modules_wrap_pos_config. -->
            <xpath expr="//sheet" position="inside">
                <div id="bl_modules_wrap_pos_config" invisible="context.get('pos_config_create_mode', False)">
                    <h2 class="bl-modules-title">Módulos BlackLabs</h2>
                    <div class="bl-card bl-card-module" id="bl_qz_engine_card_pos_config">
                        <div class="bl-card-head">
                            <span class="bl-num">1</span>
                            <div>
                                <p class="bl-card-title">QZ Tray Engine</p>
                                <p class="bl-card-sub">Impresión de tickets por QZ Tray en cada computadora.
                                    <span class="bl-review-tag">queda también acá, como estaba (configuración base)</span>
                                </p>
                            </div>
                        </div>
                        <widget name="bl_qz_device_panel"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
